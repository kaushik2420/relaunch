# ----------------------------------------------------------------------
# Relaunch — environment variables
# Copy this file to .env.local and fill in real values.
# All secrets are validated at app startup by src/lib/config.ts
# ----------------------------------------------------------------------

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Relaunch
NODE_ENV=development

# Cohort caps & free trial windows (changeable WITHOUT a code deploy)
FOUNDER_CAP=30
TOTAL_CAP=500
FREE_TRIAL_FOUNDER_DAYS=90
FREE_TRIAL_DEFAULT_DAYS=20
MONTHLY_PRICE_INR=399

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Token encryption (Google refresh tokens) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY_BASE64=

# --- LLM provider ---
# Switch provider via LLM_PROVIDER (anthropic | openai)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_QUALITY=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_QUALITY=gpt-4o

# --- Job providers ---
# Comma-separated list, evaluated in order
# Add `jsearch` to enable LinkedIn/Indeed/Glassdoor (requires JSEARCH_API_KEY)
JOB_PROVIDERS=adzuna,jooble,greenhouse
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
# Optional. Leave blank to use our curated default list (~70 known
# Greenhouse-using companies, see src/lib/greenhouse-boards.ts). Set
# this if you want to override with a narrow list for testing.
GREENHOUSE_BOARDS=

# --- Google (Sheets + Gmail) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT=http://localhost:3000/api/google/callback

# --- Payments ---
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID=plan_xxx
# Stripe (optional fallback for non-India users)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=price_xxx

# --- Email ---
EMAIL_PROVIDER=resend
RESEND_API_KEY=
FROM_EMAIL=hello@get-relaunch.com

# --- Optional: referrer lookup ---
# Optional: Proxycurl/Apollo/etc. for real referrer NAMES. Without these,
# we generate a LinkedIn people-search URL that opens the user's 2nd-degree
# network at the target company — free, more useful, more private. Leave
# blank unless you specifically want paid LinkedIn data lookups.
PROXYCURL_API_KEY=

# JSearch via RapidAPI — adds LinkedIn / Indeed / Glassdoor to job sources.
# Sign up: https://rapidapi.com (Basic plan ~$10/mo). Then add `jsearch`
# to JOB_PROVIDERS above to activate it.
JSEARCH_API_KEY=

# --- Observability ---
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Cron security ---
# A random string. Cron handler rejects requests without this header.
CRON_SECRET=
